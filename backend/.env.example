# Application Environment (development, production, testing)
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Supabase / PostgreSQL Direct Database Connection (asyncpg)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/campus_uncut

# AI / LLM Configuration (Groq or Mock fallback)
# LLM_PROVIDER: "groq" for real LLM tool-calling, or "mock" for deterministic rule-based engine.
# When LLM_PROVIDER=groq and LLM_API_KEY is supplied, FastAPI uses Groq's free tier.
# Free API key can be obtained in 1 minute from https://console.groq.com/keys (100% free / ₹0 cost).
# If the key is missing, invalid, or rate limited, the backend automatically falls back to "mock".
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=25.0

# CORS Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
